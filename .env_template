# Copia este archivo como .env y completa los valores de tu entorno.
# Todas las variables son opcionales: config.py tiene defaults.
# Los parámetros no sensibles también pueden definirse en settings/settings.json
# (las variables de entorno tienen precedencia sobre el JSON).
# Los secretos (usuarios, tokens, PINs) solo van aquí, nunca en settings.json.

# API
QA_API_BASE_URL=https://pokeapi.co/api/v2
QA_API_TIMEOUT=30

# Web
QA_WEB_BASE_URL=https://example.com
QA_WEB_BROWSER=chrome
QA_WEB_HEADLESS=false

# Appium (local o UFT Digital Lab)
APPIUM_SERVER_URL=http://127.0.0.1:4723/wd/hub
APPIUM_PLATFORM_NAME=Android
APPIUM_AUTOMATION_NAME=UiAutomator2

# ADB - ruta al ejecutable si no esta en PATH
# ADB_PATH=C:\platform-tools\adb.exe
ADB_TIMEOUT=30

# Dispositivos POS (completar seriales reales)
DEFAULT_POS_DEVICE=POS_PAX_1
POS_PAX_1_ADB_SERIAL=
POS_PAX_1_UDID=
POS_PAX_1_UNLOCK_PIN=
POS_PAX_1_APP_PACKAGE=com.getnet.getnetapp
POS_PAX_1_APP_ACTIVITY=com.coasin.getnetapp.presenter.MainActivity

POS_INGENICO_1_ADB_SERIAL=
POS_INGENICO_1_UDID=
POS_INGENICO_1_UNLOCK_PIN=
POS_INGENICO_1_APP_PACKAGE=
POS_INGENICO_1_APP_ACTIVITY=

# Jira (opcional - publicar resultados / crear issues)
JIRA_BASE_URL=
JIRA_USER=
JIRA_TOKEN=
JIRA_PROJECT=

# ALM / Xray (opcional)
ALM_BASE_URL=
ALM_USER=
ALM_TOKEN=
ALM_PROJECT=

# Reportes
# REPORT_OUTPUT_DIR=output
